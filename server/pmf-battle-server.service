# systemd unit for the pmf-battle relay server.
# Install (adjust User/WorkingDirectory/node path):
#   sudo cp pmf-battle-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pmf-battle-server
#   journalctl -u pmf-battle-server -f
[Unit]
Description=pmf-battle relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmfbattle
WorkingDirectory=/opt/pmf-battle/server
ExecStart=/usr/bin/node /opt/pmf-battle/server/server.js
Environment=PORT=7777
Environment=HOST=0.0.0.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/pmf-battle/server/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
